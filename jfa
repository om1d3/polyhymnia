#!/bin/sh
# jfa - start Polyhymnia in Docker.
# Use jfa in the folder that contains your data (exports, edited files, backups, covers):
#   cd data && ../jfa check-names jellyfin_names_part0*_edited.json
#   ../jfa bg covers-fetch       starts the command in the background (it continues when you close the session)
set -e
repo=$(cd "$(dirname "$0")" && pwd)
if [ "$PWD" = "$repo" ]; then
    mkdir -p "$repo/data"
    echo "Do not use jfa in the program folder. Go to your data folder. Example: cd data && ../jfa $*" >&2
    exit 1
fi
if [ ! -f "$repo/.env" ]; then
    echo "Cannot find $repo/.env. Copy .env.example to .env. Then write your values in .env." >&2
    exit 1
fi
export WORK="$PWD"
compose() { docker compose --project-directory "$repo" -f "$repo/compose.yaml" "$@"; }
compose build --quiet
if [ "${1:-}" = "bg" ]; then
    shift
    name="jfa-${1:-job}"
    docker rm -f "$name" >/dev/null 2>&1 || true
    compose run -d --name "$name" audit "$@" >/dev/null
    echo "The command started in the background. Name: $name"
    echo "To see the progress: docker logs --tail 3 $name"
    echo "When the command is complete: docker rm $name"
    exit 0
fi
compose run --rm audit "$@"
